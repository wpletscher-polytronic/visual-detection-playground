# Python virtual environment — rebuild with:
#   python -m venv venv && venv\Scripts\pip install -r requirements.txt
venv/

# Everything scripts write out — regenerated by running them, never authored
Playground/output/

# Roboflow datasets — shared by Playground and centerpoint, which is why they sit at
# repo root rather than inside either. Regenerated by Playground/src/prepare_bullet_*.py
# Ignore the children, not datasets/ itself, so the exception below can re-include
# examples/ — git cannot un-ignore anything inside an excluded directory.
datasets/*

# The five hand-picked qualitative examples ARE tracked: small, static, hand-chosen,
# and the only images both projects run against. Not generated, so not regenerable.
!datasets/examples/
!datasets/README.md

# Pretrained model checkpoints — large binaries, redownloaded by ultralytics
Playground/data/models/

# Third-party papers — not ours to redistribute. RESEARCH.md (ours) is kept.
Playground/papers/*.pdf

CenterNet

# Stray folder ultralytics' AMP check recreates at repo root on every run
/weights/

__pycache__/
*.pyc

# Real secrets — .env.example (checked in) shows the expected variable names
.env

# centerpoint run artefacts — checkpoints, heatmap dumps, eval results
centerpoint/outputs/

# Claude Code. CLAUDE.md itself IS committed — it is shared project documentation,
# same category as README.md. Only personal settings and runtime state are ignored.
# (Claude Code also writes these to .git/info/exclude, but that file is local-only
# and does not survive a fresh clone, so the durable rules live here.)
.claude/settings.local.json
.claude/scheduled_tasks.*
.claude/routines/.state/
.claude/worktrees/
.claude/checkpoints/
.claude/mailbox/
.claude/agent-registry.json
.claude/agent-memory-local
.claude/first-run
.claude/assistant-daemon-state.json
CLAUDE.local.md
